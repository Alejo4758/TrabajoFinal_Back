generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// 1. USUARIOS, PERFILES Y VALIDACIÓN
// ==========================================

// Main user table for registration and login
model User {
  id                Int       @id @default(autoincrement())
  email             String    @unique
  password          String
  name              String    @map("nombre")
  lastName          String    @map("apellidos")
  documentType      String    @map("tipo_doc")
  documentNumber    String    @unique @map("nro_doc")
  role              Role      @default(CLIENT) @map("rol")
  emailVerified     Boolean   @default(false) @map("emailVerificado")
  verificationToken String?   @unique
  tokenExpiresAt    DateTime? @map("tokenExpira")
  // URL HTTPS (Cloudinary) de la foto de perfil; null si el usuario no subió ninguna
  profilePicture    String?   @map("foto_perfil")
  createdAt         DateTime  @default(now())

  // Relaciones de rol
  profileAT ProfileAT?
  admin     Admin?

  // Relaciones del Sistema de Chat
  conversations ConversationUser[]
  messagesSent  Message[]          @relation("SenderMessages")

  // Relaciones del Calendario (como titular de la cuenta: tutor/familiar del paciente)
  calendarActivities CalendarActivity[] @relation("UserCalendar")

  notifications Notification[]

  // Solicitudes de vinculación enviadas (como cliente)
  linkRequestsSent LinkRequest[]

  // Personas a su cargo que reciben el acompañamiento (como cliente)
  patients Patient[]

  @@map("Usuario")
}

model Admin {
  id     Int  @id @default(autoincrement())
  userId Int  @unique @map("usuarioId")
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  validations Validation[]

  // Sugerencias de especialidades y obras sociales que revisó
  catalogSuggestions CatalogSuggestion[]

  @@map("Admin")
}

model Validation {
  id           Int      @id @default(autoincrement())
  status       StatusAT @default(PENDING) @map("estado")
  observations String?  @map("observaciones") @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  adminId Int?   @map("adminId")
  admin   Admin? @relation(fields: [adminId], references: [id])

  profileATId Int       @map("perfilATId")
  profileAT   ProfileAT @relation(fields: [profileATId], references: [id], onDelete: Cascade)

  @@map("Validacion")
}

// Additional data for therapeutic companions
model ProfileAT {
  id          Int      @id @default(autoincrement())
  dateOfBirth DateTime @map("fecha_nac")
  studies     String?  @map("estudios")
  genre       String?  @map("genero")
  status      StatusAT @default(PENDING) @map("estado")

  userId Int  @unique @map("usuarioId")
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Documentos y Validaciones
  documents   DocumentAT[]
  validations Validation[]

  // Filtros (Tablas intermedias de la pizarra)
  localities    AT_Locality[]
  especialities AT_Especiality[]
  obrasSociales AT_OSoc[]

  // Experiencia y Disponibilidad Horaria
  experiences  Experience[]
  availability AvailabilityAT[]

  // Calendario (como Acompañante Terapéutico)
  calendarActivities CalendarActivity[]

  // Solicitudes de vinculación recibidas
  linkRequests LinkRequest[]

  // Acompañamientos (pacientes vinculados)
  treatments Treatment[]

  // Especialidades y obras sociales que propuso agregar porque no estaban en la lista
  catalogSuggestions CatalogSuggestion[]

  @@map("PerfilAT")
}

// File paths for uploaded PDF/image documents
model DocumentAT {
  id      Int    @id @default(autoincrement())
  title   String @map("titulo")
  fileUrl String @map("urlArchivo")

  profileATId Int       @map("perfilATId")
  profileAT   ProfileAT @relation(fields: [profileATId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("DocumentoAT")
}

// ==========================================
// 2. SISTEMA DE FILTROS Y PERFIL PROFESIONAL
// ==========================================

model Locality {
  id             Int     @id @default(autoincrement())
  name           String  @map("nombre")
  georefId       String? @unique @map("georef_id")
  provinceName   String? @map("provincia")
  departmentName String? @map("departamento")

  ats AT_Locality[]

  @@index([provinceName, name])
  @@map("Localidad")
}

model AT_Locality {
  profileATId Int @map("atId")
  localityId  Int @map("localidadId")

  profileAT ProfileAT @relation(fields: [profileATId], references: [id], onDelete: Cascade)
  locality  Locality  @relation(fields: [localityId], references: [id], onDelete: Cascade)

  @@id([profileATId, localityId])
  @@map("AT_Localidad")
}

model Especiality {
  id   Int    @id @default(autoincrement())
  name String @map("nombre")

  ats AT_Especiality[]

  @@map("Especialidad")
}

model AT_Especiality {
  profileATId   Int @map("atId")
  especialityId Int @map("espId")

  profileAT   ProfileAT   @relation(fields: [profileATId], references: [id], onDelete: Cascade)
  especiality Especiality @relation(fields: [especialityId], references: [id], onDelete: Cascade)

  @@id([profileATId, especialityId])
  @@map("AT_Especialidad")
}

model ObraSocial {
  id   Int    @id @default(autoincrement())
  name String @map("nombre")

  ats AT_OSoc[]

  @@map("ObraSocial")
}

model AT_OSoc {
  profileATId  Int @map("atId")
  obraSocialId Int @map("osId")

  profileAT  ProfileAT  @relation(fields: [profileATId], references: [id], onDelete: Cascade)
  obraSocial ObraSocial @relation(fields: [obraSocialId], references: [id], onDelete: Cascade)

  @@id([profileATId, obraSocialId])
  @@map("AT_OSoc")
}

model Experience {
  id          Int       @id @default(autoincrement())
  title       String    @map("titulo")
  startDate   DateTime  @map("fecha_inicio")
  finishDate  DateTime? @map("fecha_fin")
  description String?   @map("descripcion") @db.Text

  profileATId Int       @map("atId")
  profileAT   ProfileAT @relation(fields: [profileATId], references: [id], onDelete: Cascade)

  @@map("Experiencia")
}

model AvailabilityAT {
  id        Int    @id @default(autoincrement())
  dayOfWeek Int    @map("dia_semana") // 0 = Domingo, 1 = Lunes, ..., 6 = Sábado
  startTime String @map("hora_inicio") // Ej: "09:00"
  endTime   String @map("hora_fin") // Ej: "18:00"

  profileATId Int       @map("atId")
  profileAT   ProfileAT @relation(fields: [profileATId], references: [id], onDelete: Cascade)

  @@map("DisponibilidadHoraria")
}

// Especialidad u obra social que un A.T. propone porque no está en la lista. La revisa un administrador:
// si la aprueba, se agrega al catálogo (o se usa la que ya existe con ese nombre) y queda en el perfil de quien la propuso
model CatalogSuggestion {
  id         Int                     @id @default(autoincrement())
  type       CatalogSuggestionType   @map("tipo")
  name       String                  @map("nombre")
  status     CatalogSuggestionStatus @default(PENDING) @map("estado")
  // Motivo del rechazo, o el nombre con el que se agregó si el administrador lo corrigió
  reviewNote String?                 @map("observaciones")
  createdAt  DateTime                @default(now())
  reviewedAt DateTime?               @map("fecha_revision")

  profileATId Int       @map("perfilATId")
  profileAT   ProfileAT @relation(fields: [profileATId], references: [id], onDelete: Cascade)

  // Administrador que la revisó. Si se borra su cuenta, la sugerencia queda revisada igual
  reviewedById Int?   @map("adminId")
  reviewedBy   Admin? @relation(fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, type])
  @@index([profileATId])
  @@map("SugerenciaCatalogo")
}

// ==========================================
// 3. SISTEMA DE CHAT
// ==========================================

model Conversation {
  id        Int      @id @default(autoincrement())
  isGroup   Boolean  @default(false) @map("es_grupo")
  title     String?  @map("titulo")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users    ConversationUser[]
  messages Message[]

  @@map("Conversacion")
}

model ConversationUser {
  conversationId Int       @map("conv_id")
  userId         Int       @map("usuario_id")
  joinedAt       DateTime  @default(now()) @map("fecha_union")
  leftAt         DateTime? @map("fecha_salida")
  lastReadAt     DateTime  @default(now()) @map("ultima_lectura") // <-- Nuevo

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@map("Conversacion_Usuario")
}

model Message {
  id             Int       @id @default(autoincrement())
  conversationId Int       @map("conv_id")
  senderId       Int       @map("remitente_id")
  content        String    @map("contenido") @db.Text
  createdAt      DateTime  @default(now())
  deletedAt      DateTime? @map("eliminado_en")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("SenderMessages", fields: [senderId], references: [id], onDelete: Cascade)

  // Reemplaza @@index([conversationId]) por el compuesto:
  @@index([conversationId, createdAt(sort: Desc)], name: "idx_mensaje_conv_fecha")
  @@index([senderId])
  @@map("Mensaje")
}

// ==========================================
// 4. SISTEMA DE CALENDARIO
// ==========================================

model CalendarActivity {
  id          Int  @id @default(autoincrement())
  profileATId Int  @map("atId")
  // Titular de la cuenta (tutor/familiar): ve la actividad en su agenda y recibe los avisos.
  // Opcional: el AT puede agendar recordatorios, trámites o supervisiones sin vincular a nadie
  userId      Int? @map("usuarioId")
  // Paciente al que se refiere la actividad. Si está, userId es siempre su tutor
  patientId   Int? @map("pacienteId")

  title       String        @map("titulo")
  description String?       @map("descripcion") @db.Text
  ubication   String?       @map("ubicacion")
  type        ActivityType  @default(SESSION) @map("tipo")
  state       ActivityState @default(PENDING) @map("estado")

  startDate  DateTime @map("fecha_inicio")
  finishDate DateTime @map("fecha_fin")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Encuentro registrado al que corresponde esta sesión (si se cargó desde el registro de encuentros)
  encounter Encounter?

  profileAT ProfileAT @relation(fields: [profileATId], references: [id], onDelete: Cascade)
  user      User?     @relation("UserCalendar", fields: [userId], references: [id], onDelete: SetNull)
  patient   Patient?  @relation(fields: [patientId], references: [id], onDelete: SetNull)

  @@index([profileATId, startDate, finishDate])
  @@index([userId, startDate])
  @@index([patientId, startDate])
  @@map("Actividad_Calendario")
}

// ==========================================
// 6. SISTEMA DE NOTIFICACIONES
// ==========================================

model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int              @map("usuario_id")
  type      NotificationType @map("tipo")
  title     String           @map("titulo")
  content   String           @map("contenido") @db.Text
  link      String?          @map("enlace") // Ej: "/chat" o "/calendario"
  isRead    Boolean          @default(false) @map("leido")
  createdAt DateTime         @default(now()) @map("creado_en")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt(sort: Desc)])
  @@map("Notificacion")
}

// ==========================================
// 7. SOLICITUDES DE VINCULACIÓN
// ==========================================

// Solicitud que un cliente le envía a un A.T. desde su perfil, para uno de sus pacientes.
// La migración add_patients_and_treatments agrega a mano un índice único parcial
// "SolicitudVinculacion_pendiente_unica" (pacienteId, perfilATId) WHERE estado = 'PENDIENTE',
// que Prisma no soporta en el schema: evita dos solicitudes pendientes iguales aunque lleguen a la vez.
// (Antes era por clienteId: un tutor con dos pacientes no podía pedir el mismo A.T. para el segundo.)
model LinkRequest {
  id             Int               @id @default(autoincrement())
  description    String            @map("descripcion") @db.Text
  locality       String            @map("localidad")
  socialPrograms String[]          @map("obras_sociales")
  otherCoverage  Boolean           @map("otra_cobertura")
  status         LinkRequestStatus @default(PENDING) @map("estado")
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  // Titular de la cuenta que envía la solicitud
  clientId Int  @map("clienteId")
  client   User @relation(fields: [clientId], references: [id], onDelete: Cascade)

  // Persona para la que se pide el acompañamiento (siempre un paciente de clientId)
  patientId Int     @map("pacienteId")
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  profileATId Int       @map("perfilATId")
  profileAT   ProfileAT @relation(fields: [profileATId], references: [id], onDelete: Cascade)

  @@index([profileATId, status])
  @@index([clientId])
  @@index([patientId])
  @@map("SolicitudVinculacion")
}

// ==========================================
// 8. PACIENTES Y ACOMPAÑAMIENTOS
// ==========================================

// Persona que recibe el acompañamiento. La carga y administra un usuario CLIENT (tutor/familiar),
// que también puede ser la misma persona (relationship = SELF).
model Patient {
  id           Int                 @id @default(autoincrement())
  name         String              @map("nombre")
  lastName     String              @map("apellidos")
  // Opcional solo por los pacientes creados al migrar datos anteriores: la API la exige al cargar uno nuevo
  dateOfBirth  DateTime?           @map("fecha_nac") @db.Date
  // Vínculo del titular de la cuenta con el paciente
  relationship PatientRelationship @map("parentesco")
  diagnosis    String?             @map("diagnostico")
  // Información adicional que carga la familia para el profesional
  notes        String?             @map("notas") @db.Text
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  tutorId Int  @map("tutorId")
  tutor   User @relation(fields: [tutorId], references: [id], onDelete: Cascade)

  treatments         Treatment[]
  linkRequests       LinkRequest[]
  calendarActivities CalendarActivity[]

  @@index([tutorId])
  @@map("Paciente")
}

// Acompañamiento: vínculo entre un paciente y un A.T. Se crea cuando el A.T. acepta una solicitud de vinculación.
// De acá cuelga lo clínico, que es propio de cada A.T. con ese paciente (hoy el plan de trabajo).
model Treatment {
  id        Int             @id @default(autoincrement())
  status    TreatmentStatus @default(ACTIVE) @map("estado")
  startDate DateTime        @default(now()) @map("fecha_inicio")
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  patientId Int     @map("pacienteId")
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  profileATId Int       @map("perfilATId")
  profileAT   ProfileAT @relation(fields: [profileATId], references: [id], onDelete: Cascade)

  workPlan   WorkPlan?
  encounters Encounter[]

  @@unique([patientId, profileATId])
  @@index([profileATId, status])
  @@map("Acompanamiento")
}

// Plan de trabajo de un acompañamiento (uno por acompañamiento).
// content guarda el plan con la forma que arma el formulario del front; la valida src/services/plan.service.js
model WorkPlan {
  id        Int      @id @default(autoincrement())
  content   Json     @map("contenido")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  treatmentId Int       @unique @map("acompanamientoId")
  treatment   Treatment @relation(fields: [treatmentId], references: [id], onDelete: Cascade)

  @@map("PlanTrabajo")
}

// Encuentro que registra el A.T. en un acompañamiento: qué objetivos del plan trabajó, cómo los valoró,
// qué actividades hizo y sus observaciones. Lo valida src/services/encounter.service.js.
// Los objetivos y el ámbito viven en el plan (JSON) y se referencian por su id. Además se guarda una copia del texto
// del objetivo y del nombre del ámbito al momento de registrar: si después se corrige o se borra del plan,
// el historial se sigue leyendo igual que el día del encuentro.
// Cada encuentro queda también en el calendario como una sesión completada (calendarActivity).
model Encounter {
  id              Int      @id @default(autoincrement())
  // Fecha y hora de inicio. El A.T. la carga en hora de Argentina; se guarda como instante, igual que el calendario
  startDate       DateTime @map("fecha_inicio")
  durationMinutes Int      @map("duracion_min")
  stageId         String   @map("ambitoId")
  stageName       String   @map("ambito")
  activities      String[] @map("actividades")
  observations    String?  @map("observaciones") @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  treatmentId Int       @map("acompanamientoId")
  treatment   Treatment @relation(fields: [treatmentId], references: [id], onDelete: Cascade)

  // Sesión del calendario que corresponde a este encuentro. Si el A.T. la borra del calendario, el encuentro queda igual
  calendarActivityId Int?              @unique @map("actividadId")
  calendarActivity   CalendarActivity? @relation(fields: [calendarActivityId], references: [id], onDelete: SetNull)

  goals EncounterGoal[]

  // Un paciente no puede tener dos encuentros con la misma fecha y hora (también sirve de índice para el historial)
  @@unique([treatmentId, startDate])
  @@map("Encuentro")
}

// Objetivo trabajado en un encuentro, con el nivel observado.
// La migración add_encounters agrega a mano un CHECK que limita "nivel" de 1 a 5 (Prisma no soporta CHECK en el schema)
model EncounterGoal {
  id       Int     @id @default(autoincrement())
  // id del objetivo específico en el plan de trabajo (WorkPlan.content.stages[].specificGoals[].id)
  goalId   String  @map("objetivoId")
  goalText String  @map("objetivo")
  // Escala de 1 (aún no lo logra) a 5 (autónomo), la misma de utils/scale.js en el front
  level    Int     @map("nivel")
  note     String? @map("nota")

  encounterId Int       @map("encuentroId")
  encounter   Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)

  @@unique([encounterId, goalId])
  @@map("EncuentroObjetivo")
}

// ==========================================
// 5. ENUMS
// ==========================================

enum NotificationType {
  CHAT_MESSAGE      @map("CHAT_MENSAJE")
  INTERVIEW_REQUEST @map("SOLICITUD_ENTREVISTA")
  INTERVIEW_STATUS  @map("ESTADO_ENTREVISTA")
  PROFILE_VALIDATED @map("PERFIL_VALIDADO")
  ACTIVITY_REMINDER @map("RECORDATORIO_ACTIVIDAD")

  @@map("TipoNotificacion")
}

// Allowed platform roles
enum Role {
  CLIENT @map("CLIENTE")
  AT
  ADMIN

  @@map("Role")
}

// Validation states for therapeutic companions
enum StatusAT {
  PENDING  @map("PENDIENTE")
  APPROVED @map("APROBADO")
  REJECTED @map("RECHAZADO")

  @@map("EstadoAT")
}

// Qué catálogo se propone ampliar
enum CatalogSuggestionType {
  ESPECIALITY @map("ESPECIALIDAD")
  OBRA_SOCIAL @map("OBRA_SOCIAL")

  @@map("TipoSugerencia")
}

// Estado de una sugerencia de especialidad u obra social
enum CatalogSuggestionStatus {
  PENDING  @map("PENDIENTE")
  APPROVED @map("APROBADA")
  REJECTED @map("RECHAZADA")

  @@map("EstadoSugerencia")
}

// Link request states
enum LinkRequestStatus {
  PENDING  @map("PENDIENTE")
  ACCEPTED @map("ACEPTADA")
  REJECTED @map("RECHAZADA")

  @@map("EstadoSolicitud")
}

// Vínculo del titular de la cuenta con el paciente ("soy su ...")
enum PatientRelationship {
  SELF           @map("TITULAR") // el paciente es el propio titular de la cuenta
  PARENT         @map("MADRE_PADRE")
  CHILD          @map("HIJO")
  SIBLING        @map("HERMANO")
  GRANDPARENT    @map("ABUELO")
  PARTNER        @map("PAREJA")
  LEGAL_GUARDIAN @map("TUTOR_LEGAL")
  OTHER          @map("OTRO")

  @@map("Parentesco")
}

// Treatment states
enum TreatmentStatus {
  ACTIVE   @map("ACTIVO")
  PAUSED   @map("EN_PAUSA")
  FINISHED @map("FINALIZADO")

  @@map("EstadoAcompanamiento")
}

// Calendar activity types
enum ActivityType {
  SESSION   @map("SESION")
  INTERVIEW @map("ENTREVISTA")
  MEETING   @map("REUNION")
  OTHER     @map("OTRO")

  @@map("TipoActividad")
}

// Calendar activity states
enum ActivityState {
  PENDING   @map("PENDIENTE")
  CONFIRMED @map("CONFIRMADO")
  CANCELLED @map("CANCELADO")
  COMPLETED @map("COMPLETADO")

  @@map("EstadoActividad")
}
