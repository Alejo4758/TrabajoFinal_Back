# Copiá este archivo como .env y completá los valores. Nunca subas el .env al repositorio.

# BASE DE DATOS (con docker-compose: postgresql://USUARIO:CLAVE@localhost:5434/acompanantes_db)
DATABASE_URL=

# JSON WEB TOKEN
JWT_SECRET=

# PUERTO DEL SERVIDOR (opcional, por defecto 3000)
# PORT=3000

# CREDENCIALES PARA EL ENVIO DE EMAILS
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASS=

# CREDENCIALES CLOUDINARY
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# GOOGLE GEMINI (borradores de informes y chat con IA)
# Se obtiene en https://aistudio.google.com/apikey. Si falta, la API funciona igual
# y solo los endpoints de IA de /api/patients/:patientId/reports responden 503.
GEMINI_API_KEY=
# Modelos en orden de preferencia, separados por coma (opcional). Si uno está saturado o retirado, se usa el siguiente.
# Por defecto: gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.8-flash,gemini-3.1-flash-lite
# GEMINI_MODELS=
# Cuánto razona el modelo antes de responder: minimal, low, medium, high o default (opcional, por defecto low).
# Más bajo = más rápido y menos cortes por tiempo; para redactar informes no hace falta más
# GEMINI_THINKING_LEVEL=low
